# Application
APP_NAME=chatbot
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot

# AI model
AI_MODEL=openai:gpt-4.1-mini
AI_TEMPERATURE=0.2
# AI_MAX_TOKENS=4096
AI_TIMEOUT=30
AI_MAX_RETRIES=3

# Provider credentials
OPENAI_API_KEY=
TAVILY_API_KEY=

# Agent tools
TOOL_WORKSPACE=.chatbot-workspaces
PYTHON_IMAGE=python:3.13-alpine
PYTHON_TIMEOUT_SECONDS=10

# Security: replace this with a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
